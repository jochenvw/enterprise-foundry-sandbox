<!--
  Team inference API policy (applied at API scope).
  Build-time placeholders replaced per team in apim-ai-gateway.bicep:
    {TEAM_NAME}            - e.g. team-a
    {TOKEN_LIMIT_POLICY}   - azure-openai-token-limit element or empty
    {TOKEN_METRIC_POLICY}  - azure-openai-emit-token-metric element or empty
    {CONTENT_SAFETY}       - llm-content-safety fragment or empty
  Runtime named values (APIM): {{central-foundry-base-url}},
    {{central-deployment}}, {{openai-api-version}}, {{enable-prompt-logging}}

  Team-facing surface is the clean route:
    POST /ai/{team}/deployments/{deploymentName}/chat/completions
  The Azure OpenAI-specific /openai segment is hidden behind the backend base URL,
  so teams never see provider-specific paths.
-->
<policies>
  <inbound>
    <base />
    <!-- Caller separation: the subscription key is scoped to this team's product only. -->
    <set-variable name="team" value="{TEAM_NAME}" />

    <!-- Governance: only the approved central deployment may be requested through
         this route. Any other deployment name is rejected at the gateway. -->
    <set-variable name="deploymentName" value="@(context.Request.MatchedParameters.ContainsKey(&quot;deploymentName&quot;) ? context.Request.MatchedParameters[&quot;deploymentName&quot;] : &quot;&quot;)" />
    <choose>
      <when condition="@(!string.IsNullOrEmpty((string)context.Variables[&quot;deploymentName&quot;]) &amp;&amp; (string)context.Variables[&quot;deploymentName&quot;] != &quot;{{central-deployment}}&quot;)">
        <return-response>
          <set-status code="403" reason="Deployment not allowed" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"error":{"code":"DeploymentNotAllowed","message":"The requested deployment is not allowed for this gateway route."}}</set-body>
        </return-response>
      </when>
    </choose>

    <!-- Route to the central Foundry Azure OpenAI surface. The /openai segment is
         appended here so the team-facing route stays provider-agnostic. -->
    <set-backend-service base-url="{{central-foundry-base-url}}/openai" />

    <!-- Enforce the inference API version regardless of what the caller sent. -->
    <set-query-parameter name="api-version" exists-action="override">
      <value>{{openai-api-version}}</value>
    </set-query-parameter>

    <!-- APIM managed identity authenticates to the central Foundry (no keys). -->
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" output-token-variable-name="msi-access-token" ignore-error="false" />
    <set-header name="Authorization" exists-action="override">
      <value>@("Bearer " + (string)context.Variables["msi-access-token"])</value>
    </set-header>

    <!-- Never forward the APIM subscription key to the model backend. -->
    <set-header name="api-key" exists-action="delete" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />

    <!-- Token governance + metrics apply only to chat-completions inference. -->
    <choose>
      <when condition="@(context.Operation.Name == &quot;chat-completions&quot;)">
        {TOKEN_LIMIT_POLICY}
        {TOKEN_METRIC_POLICY}
        {CONTENT_SAFETY}
      </when>
    </choose>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <!-- Metadata-only logging by default. Prompt/response bodies are NOT logged.
         Set the enable-prompt-logging named value to "true" to opt in. -->
    <set-variable name="logBody" value="{{enable-prompt-logging}}" />
    <trace source="enterprise-foundry" severity="information">
      <message>@($"team={(string)context.Variables["team"]} api={context.Api.Name} op={context.Operation.Name} deployment={(string)context.Variables["deploymentName"]} status={context.Response.StatusCode} duration-ms={context.Elapsed.TotalMilliseconds} request-id={context.RequestId}")</message>
    </trace>
  </outbound>
  <on-error>
    <base />
    <set-header name="x-enterprise-error" exists-action="override">
      <value>@(context.LastError?.Message ?? "unknown")</value>
    </set-header>
  </on-error>
</policies>
